PORT=3000
FRONTEND_URL=http://localhost:4200

# Generate a long random value for production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Token from https://console.apify.com/account/integrations
APIFY_TOKEN=your-apify-token
APIFY_ACTOR_URL=https://api.apify.com/v2/acts/jungle_synthesizer~jolpica-f1-results-scraper/run-sync-get-dataset-items
APIFY_MAX_ITEMS=600
APIFY_TIMEOUT_MS=120000
F1_CACHE_HOURS=3

# Optional. Defaults to data/f1-race-manager.db
DB_PATH=./data/f1-race-manager.db
