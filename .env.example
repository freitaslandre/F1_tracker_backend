PORT=3000
FRONTEND_URL=http://localhost:4200

# Generate a long random value for production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Token from https://console.apify.com/account/integrations
APIFY_TOKEN=your-apify-token
APIFY_ACTOR_URL=https://api.apify.com/v2/acts/jungle_synthesizer~jolpica-f1-results-scraper/run-sync-get-dataset-items
APIFY_MAX_ITEMS=600
APIFY_TIMEOUT_MS=120000
F1_CACHE_HOURS=3

# Firestore persistence. Use one of these options:
# Local development: path to the private service account JSON downloaded from Firebase.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/absolute/path/to/firebase-service-account.json

# Production deploy: paste the full JSON as a single-line environment variable instead of committing the file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=f1-race-manager
